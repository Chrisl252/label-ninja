{
  "name": "label-ninja",
  "version": "1.0.0",
  "description": "Browser-based thermal label studio for reseller workflows",
  "private": true,
  "scripts": {
    "test": "node scripts/test-spec-builders.mjs && node scripts/test-redesign-contract.mjs && node scripts/test-launch.mjs",
    "test:integration": "node scripts/test-b3-integration.mjs",
    "test:projects": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\test-b5-projects-local.ps1",
    "test:runtime": "node scripts/test-password-runtime.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chrisl252/label-ninja.git"
  },
  "keywords": [
    "thermal-labels",
    "barcodes",
    "reselling"
  ],
  "author": "Bisket LLC",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Chrisl252/label-ninja/issues"
  },
  "homepage": "https://github.com/Chrisl252/label-ninja#readme",
  "devDependencies": {
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "pdf-lib": "^1.17.1"
  }
}
