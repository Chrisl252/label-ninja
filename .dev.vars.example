# Label Ninja local dev secrets — copy to .dev.vars (git-ignored) for `wrangler dev`.
# Use obvious fakes locally; real test-mode values only where noted.
# NEVER put these in wrangler.toml (it is committed).
# Production: npx wrangler secret put <NAME>   (full checklist in SYSTEM_REFERENCE.md)
APP_ORIGIN=http://127.0.0.1:8787
# Optional for local recovery testing. Verify the sender domain before real use.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Label Ninja <support@example.com>
